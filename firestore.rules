rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function validRole(role) {
      return role == "RIDER" || role == "DRIVER";
    }

    function hasRole(role) {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }

    match /users/{userId} {
      allow read, update, delete: if isOwner(userId);
      allow create: if isOwner(userId)
        && validRole(request.resource.data.role)
        && request.resource.data.email == request.auth.token.email;
    }

    match /drivers/{driverId} {
      allow read: if isOwner(driverId);
      allow create, update, delete: if isOwner(driverId) && hasRole("DRIVER");
    }

    match /rides/{rideId} {
      allow read: if signedIn() && (
        resource.data.status == "SEARCHING" ||
        resource.data.riderId == request.auth.uid ||
        resource.data.driverId == request.auth.uid
      );

      allow create: if signedIn()
        && request.resource.data.riderId == request.auth.uid
        && request.resource.data.status == "SEARCHING"
        && request.resource.data.driverId == null;

      allow update: if signedIn() && (
        validDriverAcceptance() ||
        validParticipantUpdate() ||
        validRiderRating()
      );

      function validDriverAcceptance() {
        return resource.data.status == "SEARCHING"
          && hasRole("DRIVER")
          && request.resource.data.status == "ACCEPTED"
          && request.resource.data.driverId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["driverId", "driverName", "status"]);
      }

      function validParticipantUpdate() {
        return (
          resource.data.riderId == request.auth.uid
          && request.resource.data.status == "CANCELLED"
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status"])
        ) || (
          resource.data.driverId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["status", "driverLocation"])
          && (
            request.resource.data.status == resource.data.status ||
            resource.data.status == "ACCEPTED" && request.resource.data.status == "DRIVER_ARRIVING" ||
            resource.data.status == "DRIVER_ARRIVING" && request.resource.data.status == "IN_PROGRESS" ||
            resource.data.status == "IN_PROGRESS" && request.resource.data.status == "COMPLETED" ||
            request.resource.data.status == "CANCELLED"
          )
        );
      }

      function validRiderRating() {
        return resource.data.riderId == request.auth.uid
          && resource.data.status == "COMPLETED"
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["rating"])
          && request.resource.data.rating is int
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5;
      }
    }
  }
}
